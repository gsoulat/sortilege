# Copier en .env et remplir. Le .env n'est JAMAIS commite.

# --- Chemins (tels que vus DANS le conteneur) ---
# Plusieurs racines sources possibles, separees par ':'
SORTILEGE_SOURCE_ROOTS=/storage/downloads
SORTILEGE_LIBRARY_ROOT=/storage/media

# Zones que l'interface peut PARCOURIR, au-dela des sources ci-dessus.
# Un NAS monte souvent un volume entier (« /volume1:/storage ») dont seuls
# quelques dossiers servent de source : sans cette variable, les autres
# dossiers sont montes mais invisibles dans l'explorateur.
SORTILEGE_ALLOWED_ROOTS=/storage

# --- Fournisseurs de metadonnees ---
# TMDB propose deux identifiants : la « Cle d'API » (32 caracteres hexa)
# ou le « Jeton d'acces en lecture » (long, commence par eyJ). Les deux
# fonctionnent, le format est reconnu automatiquement.
TMDB_API_KEY=
TVDB_API_KEY=
# AniList ne demande pas de cle pour la recherche publique

# --- Resolveur IA (optionnel, desactive par defaut) ---
# Appele uniquement quand le score deterministe est ambigu.
SORTILEGE_AI_ENABLED=false
ANTHROPIC_API_KEY=

# --- Securite ---
# Genere avec: python -c "import secrets; print(secrets.token_urlsafe(48))"
SORTILEGE_SECRET_KEY=
SORTILEGE_ADMIN_PASSWORD=

# --- Comportement ---
# VERROU : true interdit toute execution, quel que soit le bouton clique.
# Laisse a false pour l'usage normal — l'interface propose « Simuler » et
# « Executer » cote a cote, et simuler reste le defaut de toute requete.
SORTILEGE_DRY_RUN=false

# Au-dessus de ce score : application automatique.
SORTILEGE_AUTO_APPLY_THRESHOLD=0.92
# En dessous de ce score : rejet direct, sans encombrer la file de revue.
SORTILEGE_REJECT_THRESHOLD=0.40
